{
  "name": "huskykit-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed:campus": "node --env-file-if-exists=.env scripts/seedCampus.js",
    "seed:academic": "node --env-file-if-exists=.env scripts/seedAcademic.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/*.integration.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "express-session": "^1.19.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1"
  }
}
