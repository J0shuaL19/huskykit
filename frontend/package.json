{
  "name": "huskykit-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{jsx,js,css}\" index.html vite.config.js eslint.config.js package.json",
    "format:check": "prettier --check \"src/**/*.{jsx,js,css}\" index.html vite.config.js eslint.config.js package.json"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  }
}
